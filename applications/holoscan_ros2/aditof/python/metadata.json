{
        "application": {
                "name": "Holoscan ROS2 ADI ADTF3175 ToF Camera Publisher/Subscriber",
                "authors": [
                        {
                                "name": "ADI Holoscan Team",
                                "affiliation": "Analog Devices Inc."
                        }
                ],
                "language": "Python",
                "version": "1.0.0",
                "changelog": {
                        "1.0": "Initial Release — ADI ADTF3175 ToF sensor ROS 2 publisher and subscriber (Python)"
                },
                "holoscan_sdk": {
                        "minimum_required_version": "3.9",
                        "tested_versions": [
                                "3.9.0"
                        ]
                },
                "dockerfile": "applications/holoscan_ros2/aditof/Dockerfile",
                "platforms": [
                        "aarch64"
                ],
                "tags": ["Robotics", "ROS2", "ToF", "ADI", "ADTF3175", "Publisher", "Subscriber", "DepthCamera", "Python"],
                "ranking": 1,
                "requirements": {},
                "dependencies": {
                        "external": {}
                },
                "default_mode": "publisher",
                "modes": {
                        "publisher": {
                                "description": "ROS2 publisher that captures Depth, AB and Confidence images from the ADI ADTF3175 ToF sensor via HSB and publishes them to /aditof/depth_image, /aditof/ab_image and /aditof/conf_image",
                                "run": {
                                        "command": "bash -c 'source /opt/ros/jazzy/setup.bash && PYTHONPATH=<holohub_bin>/python/lib:<holohub_app_source>:$PYTHONPATH python3 <holohub_app_source>/adcam_ros2_publisher.py'",
                                        "workdir": "holohub_bin"
                                }
                        },
                        "subscriber": {
                                "description": "ROS2 subscriber that receives Depth, AB and Confidence images from the ADI ADTF3175 topics and visualizes them side-by-side using HolovizOp",
                                "run": {
                                        "command": "bash -c 'source /opt/ros/jazzy/setup.bash && PYTHONPATH=<holohub_bin>/python/lib:<holohub_app_source>:$PYTHONPATH python3 <holohub_app_source>/adcam_ros2_subscriber.py'",
                                        "workdir": "holohub_bin"
                                }
                        }
                }
        }
}
